<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Craft Assistant{% endblock %}</title>
    <style>
        :root {
            --bg: #10131a;
            --panel: #171b24;
            --panel-2: #1e2430;
            --line: #2a3140;
            --text: #e6e9ef;
            --muted: #9aa4b5;
            --accent: #4f9dff;
            --ok: #46c08a;
            --warn: #e0a63c;
            --err: #e2685f;
            --mono: ui-monospace, "JetBrains Mono", "SF Mono", Menlo, Consolas, monospace;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font: 15px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        }
        a { color: var(--accent); }
        header.top {
            border-bottom: 1px solid var(--line);
            padding: 14px 22px;
            display: flex;
            align-items: baseline;
            gap: 14px;
            background: var(--panel);
        }
        header.top h1 { font-size: 17px; margin: 0; letter-spacing: .2px; }
        header.top .sub { color: var(--muted); font-size: 13px; }
        header.top .spacer { flex: 1; }
        header.top a.mcp { font-family: var(--mono); font-size: 12px; text-decoration: none; border: 1px solid var(--line); padding: 3px 9px; border-radius: 6px; color: var(--muted); }
        header.top a.mcp:hover { color: var(--accent); border-color: var(--accent); }
        main { max-width: 1180px; margin: 0 auto; padding: 22px; }
        .layout { display: grid; grid-template-columns: minmax(0,1fr) 340px; gap: 20px; align-items: start; }
        @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } }
        .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; }
        .chat { padding: 0; overflow: hidden; }
        .chat-head { padding: 12px 16px; border-bottom: 1px solid var(--line); display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
        .chat-head label { color: var(--muted); font-size: 13px; margin-right: 4px; }
        .chat-head input[type=text] { background: var(--panel-2); border: 1px solid var(--line); color: var(--text); border-radius: 6px; padding: 6px 9px; font: inherit; font-size: 13px; }
        .messages { padding: 16px; min-height: 420px; max-height: 62vh; overflow-y: auto; }
        .msg { margin-bottom: 16px; }
        .msg .role { font-size: 11px; letter-spacing: .8px; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
        .msg.user .bubble { background: var(--panel-2); border: 1px solid var(--line); border-radius: 10px; padding: 10px 13px; }
        .msg.bot .bubble { background: transparent; padding: 0; white-space: pre-wrap; }
        .bubble p { margin: 0 0 8px; }
        .bubble p:last-child { margin-bottom: 0; }
        .composer { border-top: 1px solid var(--line); padding: 12px 16px; display: flex; gap: 10px; }
        .composer textarea {
            flex: 1; resize: vertical; min-height: 62px; background: var(--panel-2); color: var(--text);
            border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; font: inherit;
        }
        .composer textarea:focus, .composer input:focus { outline: 1px solid var(--accent); border-color: var(--accent); }
        button {
            background: var(--accent); color: #06121f; border: 0; border-radius: 8px; padding: 10px 16px;
            font: inherit; font-weight: 600; cursor: pointer;
        }
        button:disabled { opacity: .45; cursor: not-allowed; }
        button.ghost { background: transparent; color: var(--muted); border: 1px solid var(--line); font-weight: 500; }
        button.ghost.active { color: var(--accent); border-color: var(--accent); }
        .side h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .9px; color: var(--muted); margin: 0 0 10px; }
        .side .box { padding: 14px; margin-bottom: 14px; }
        .quelle { border-left: 2px solid var(--accent); padding: 4px 0 4px 10px; margin-bottom: 10px; }
        .quelle .k { font-family: var(--mono); font-size: 12px; color: var(--accent); }
        .quelle .b { font-size: 13px; }
        .quelle .h { font-size: 12px; color: var(--muted); }
        .warnung { background: rgba(224,166,60,.10); border: 1px solid rgba(224,166,60,.35); color: #f0c67f; padding: 9px 11px; border-radius: 7px; font-size: 13px; margin-bottom: 8px; }
        .hinweis { background: rgba(70,192,138,.10); border: 1px solid rgba(70,192,138,.32); color: #9fe0c2; padding: 9px 11px; border-radius: 7px; font-size: 13px; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th, td { text-align: left; padding: 7px 9px; border-bottom: 1px solid var(--line); vertical-align: top; }
        th { color: var(--muted); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .5px; }
        td.num { text-align: right; font-family: var(--mono); white-space: nowrap; }
        .badge { display: inline-block; padding: 2px 8px; border-radius: 20px; font-size: 12px; border: 1px solid var(--line); color: var(--muted); }
        .badge.ok { color: var(--ok); border-color: rgba(70,192,138,.4); background: rgba(70,192,138,.08); }
        .badge.draft { color: var(--warn); border-color: rgba(224,166,60,.4); background: rgba(224,166,60,.08); }
        .muted { color: var(--muted); }
        .mono { font-family: var(--mono); font-size: 13px; }
        .flash { padding: 10px 14px; border: 1px solid rgba(70,192,138,.35); background: rgba(70,192,138,.1); color: #9fe0c2; border-radius: 8px; margin-bottom: 16px; }
        footer { color: var(--muted); font-size: 12px; text-align: center; padding: 20px; }
    </style>
</head>
<body>
<header class="top">
    <h1>Craft Assistant</h1>
    <span class="sub">Prices and quotations from the master data of the business — with their origin.</span>
    <span class="spacer"></span>
    <a class="mcp" href="/mcp">MCP endpoint</a>
</header>
<main>
    {% block body %}{% endblock %}
</main>
<footer>
    All prices come from the master data. AI calculations run locally (Ollama), without data leaving the machine.
</footer>
{% block javascripts %}{% endblock %}
</body>
</html>
